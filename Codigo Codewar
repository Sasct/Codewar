public class StringSplit {
    public static String[] solution(String s) {
      if (s.length() % 2 != 0){
          s += "_";
        }
      String[] resultado = new String[s.length() / 2];
      
      for (int i = 0, j = 0; i < s.length(); i += 2, j++)
{
        resultado[j] = s.substring(i, i + 2);
    }
      return resultado;
  }
}
