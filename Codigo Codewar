public class DnaStrand {
    public static String makeComplement(String dna) {
        String resultado = "";

        for (char c : dna.toCharArray()) {
            switch (c) {
                case 'A':
                    resultado += 'T';
                    break;
                case 'T':
                    resultado += 'A';
                    break;
                case 'C':
                    resultado += 'G';
                    break;
                case 'G':
                    resultado += 'C';
                    break;
            }
        }

        return resultado;
    }
}
