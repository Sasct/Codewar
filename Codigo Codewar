import java.util.Arrays;
import java.util.HashSet;
import java.util.Set;

public class Kata {

  public static int[] arrayDiff(int[] a, int[] b) {
    Set<Integer> eliminar = new HashSet<>();
    
    for (int num : b){
        eliminar.add(num);
    }
    
    return Arrays.stream(a)
            .filter(x -> !eliminar.contains(x))
            .toArray();
  }

}
