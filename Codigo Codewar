import java.util.Map;

public class PeteBaker {

    public static int cakes(Map<String, Integer> recipe,
                            Map<String, Integer> available) {

        int minimo = Integer.MAX_VALUE;

        for (String ingrediente : recipe.keySet()) {

            if (!available.containsKey(ingrediente)) {
                return 0;
            }

            int posibles =
                available.get(ingrediente) / recipe.get(ingrediente);

            minimo = Math.min(minimo, posibles);
        }

        return minimo;
    }
}
